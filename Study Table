<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Student Planner</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0d0f14;
      --surface: #161a23;
      --card: #1e2330;
      --border: #2a3045;
      --accent: #6ee7b7;
      --accent2: #818cf8;
      --accent3: #f9a8d4;
      --text: #e2e8f0;
      --muted: #64748b;
      --danger: #f87171;
      --warn: #fbbf24;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 0 0 60px;
    }

    /* Header */
    header {
      background: linear-gradient(135deg, #0d1117 0%, #161a23 100%);
      border-bottom: 1px solid var(--border);
      padding: 24px 20px 20px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    header::before {
      content: '';
      position: absolute;
      top: -60px; left: 50%; transform: translateX(-50%);
      width: 400px; height: 200px;
      background: radial-gradient(ellipse, rgba(110,231,183,.18) 0%, transparent 70%);
      pointer-events: none;
    }
    header h1 {
      font-family: 'Syne', sans-serif;
      font-size: clamp(1.6rem, 5vw, 2.4rem);
      font-weight: 800;
      letter-spacing: -1px;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    header p {
      color: var(--muted);
      font-size: .85rem;
      margin-top: 4px;
      font-weight: 300;
    }

    /* Tabs */
    .tabs {
      display: flex;
      justify-content: center;
      gap: 8px;
      padding: 20px 16px 0;
    }
    .tab-btn {
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--muted);
      font-family: 'DM Sans', sans-serif;
      font-size: .85rem;
      font-weight: 500;
      padding: 8px 18px;
      border-radius: 100px;
      cursor: pointer;
      transition: all .2s;
    }
    .tab-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #0d0f14;
      font-weight: 700;
    }

    /* Panels */
    .panel { display: none; padding: 20px 16px 0; max-width: 680px; margin: auto; }
    .panel.active { display: block; }

    /* Section label */
    .section-label {
      font-family: 'Syne', sans-serif;
      font-size: .7rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 10px;
    }

    /* Card */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px;
      margin-bottom: 16px;
      animation: fadeUp .3s ease both;
    }
    @keyframes fadeUp {
      from { opacity:0; transform:translateY(10px); }
      to   { opacity:1; transform:translateY(0); }
    }

    /* Form elements */
    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 12px;
    }
    label {
      font-size: .78rem;
      font-weight: 500;
      color: var(--muted);
      letter-spacing: .5px;
    }
    input[type=text], input[type=date], select {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-size: .9rem;
      padding: 10px 14px;
      width: 100%;
      outline: none;
      transition: border-color .2s;
    }
    input:focus, select:focus { border-color: var(--accent); }
    input[type=date]::-webkit-calendar-picker-indicator { filter: invert(.5); }

    .btn {
      width: 100%;
      padding: 11px;
      border: none;
      border-radius: 8px;
      font-family: 'DM Sans', sans-serif;
      font-size: .9rem;
      font-weight: 700;
      cursor: pointer;
      transition: all .2s;
      margin-top: 4px;
    }
    .btn-primary {
      background: var(--accent);
      color: #0d0f14;
    }
    .btn-primary:hover { filter: brightness(1.1); transform: translateY(-1px); }
    .btn-danger {
      background: transparent;
      border: 1px solid var(--danger);
      color: var(--danger);
      padding: 5px 10px;
      border-radius: 6px;
      font-size: .75rem;
      font-weight: 600;
      width: auto;
      margin-top: 0;
    }
    .btn-done {
      background: transparent;
      border: 1px solid var(--accent);
      color: var(--accent);
      padding: 5px 10px;
      border-radius: 6px;
      font-size: .75rem;
      font-weight: 600;
      width: auto;
      margin-top: 0;
    }

    /* Empty state */
    .empty {
      text-align: center;
      color: var(--muted);
      font-size: .85rem;
      padding: 28px 0;
    }
    .empty span { font-size: 1.8rem; display: block; margin-bottom: 6px; }

    /* Timetable entry */
    .tt-entry {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
      animation: fadeUp .25s ease both;
    }
    .tt-entry:last-child { border-bottom: none; }
    .tt-day {
      background: var(--accent2);
      color: #fff;
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: .75rem;
      padding: 3px 10px;
      border-radius: 100px;
      white-space: nowrap;
      letter-spacing: .5px;
    }
    .tt-subjects {
      flex: 1;
      font-size: .88rem;
      color: var(--text);
      line-height: 1.5;
    }

    /* Assignment entry */
    .asgn-entry {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
      animation: fadeUp .25s ease both;
    }
    .asgn-entry:last-child { border-bottom: none; }
    .asgn-entry.done .asgn-name { text-decoration: line-through; color: var(--muted); }
    .asgn-info { flex: 1; }
    .asgn-name { font-weight: 500; font-size: .9rem; }
    .asgn-meta { font-size: .75rem; color: var(--muted); margin-top: 2px; }
    .asgn-meta .chip {
      display: inline-block;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 1px 8px;
      margin-right: 4px;
      font-size: .7rem;
    }
    .chip.overdue { border-color: var(--danger); color: var(--danger); }
    .chip.due-soon { border-color: var(--warn); color: var(--warn); }
    .chip.on-time  { border-color: var(--accent); color: var(--accent); }
    .asgn-actions { display: flex; gap: 6px; flex-shrink: 0; }

    /* Stats bar */
    .stats {
      display: flex;
      gap: 10px;
      margin-bottom: 16px;
    }
    .stat {
      flex: 1;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px;
      text-align: center;
    }
    .stat-num {
      font-family: 'Syne', sans-serif;
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--accent);
    }
    .stat-lbl { font-size: .7rem; color: var(--muted); margin-top: 2px; }

    /* Toast */
    #toast {
      position: fixed;
      bottom: 24px; left: 50%; transform: translateX(-50%) translateY(20px);
      background: var(--accent);
      color: #0d0f14;
      font-weight: 700;
      font-size: .85rem;
      padding: 10px 22px;
      border-radius: 100px;
      opacity: 0;
      pointer-events: none;
      transition: all .3s;
      white-space: nowrap;
      z-index: 999;
    }
    #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  </style>
</head>
<body>

<header>
  <h1>📚 Student Planner</h1>
  <p>Timetable &amp; Assignment Tracker</p>
</header>

<div class="tabs">
  <button class="tab-btn active" onclick="switchTab('timetable')">🗓 Timetable</button>
  <button class="tab-btn" onclick="switchTab('assignments')">📝 Assignments</button>
</div>

<!-- TIMETABLE PANEL -->
<div class="panel active" id="tab-timetable">

  <div class="card">
    <div class="section-label">Add Schedule</div>
    <div class="field">
      <label>Day</label>
      <select id="tt-day">
        <option value="">Select day…</option>
        <option>Monday</option><option>Tuesday</option><option>Wednesday</option>
        <option>Thursday</option><option>Friday</option><option>Saturday</option><option>Sunday</option>
      </select>
    </div>
    <div class="field">
      <label>Subjects (comma separated)</label>
      <input type="text" id="tt-subjects" placeholder="e.g. Math, Physics, English"/>
    </div>
    <button class="btn btn-primary" onclick="addTimetable()">Add to Timetable</button>
  </div>

  <div class="section-label">Your Schedule</div>
  <div class="card" id="tt-list-card">
    <div class="empty" id="tt-empty"><span>🗓</span>No schedule added yet</div>
    <div id="tt-list"></div>
  </div>

</div>

<!-- ASSIGNMENTS PANEL -->
<div class="panel" id="tab-assignments">

  <div class="stats">
    <div class="stat"><div class="stat-num" id="stat-total">0</div><div class="stat-lbl">Total</div></div>
    <div class="stat"><div class="stat-num" id="stat-pending" style="color:var(--warn)">0</div><div class="stat-lbl">Pending</div></div>
    <div class="stat"><div class="stat-num" id="stat-done" style="color:var(--accent)">0</div><div class="stat-lbl">Done</div></div>
  </div>

  <div class="card">
    <div class="section-label">Add Assignment</div>
    <div class="field">
      <label>Assignment Name</label>
      <input type="text" id="a-name" placeholder="e.g. Chapter 5 Notes"/>
    </div>
    <div class="field">
      <label>Subject</label>
      <input type="text" id="a-subject" placeholder="e.g. Chemistry"/>
    </div>
    <div class="field">
      <label>Deadline</label>
      <input type="date" id="a-deadline"/>
    </div>
    <button class="btn btn-primary" onclick="addAssignment()">Add Assignment</button>
  </div>

  <div class="section-label">Assignment List</div>
  <div class="card" id="a-list-card">
    <div class="empty" id="a-empty"><span>📝</span>No assignments yet</div>
    <div id="a-list"></div>
  </div>

</div>

<div id="toast"></div>

<script>
  // ── State ────────────────────────────────────────────────
  let timetable = JSON.parse(localStorage.getItem('tt') || '{}');
  let assignments = JSON.parse(localStorage.getItem('asgn') || '[]');

  // ── Tab switch ───────────────────────────────────────────
  function switchTab(name) {
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    event.currentTarget.classList.add('active');
    if (name === 'assignments') renderAssignments();
  }

  // ── Toast ────────────────────────────────────────────────
  function toast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2200);
  }

  // ── TIMETABLE ────────────────────────────────────────────
  function addTimetable() {
    const day = document.getElementById('tt-day').value.trim();
    const subjects = document.getElementById('tt-subjects').value.trim();
    if (!day || !subjects) { toast('⚠ Fill in day & subjects'); return; }
    timetable[day] = subjects;
    localStorage.setItem('tt', JSON.stringify(timetable));
    document.getElementById('tt-day').value = '';
    document.getElementById('tt-subjects').value = '';
    renderTimetable();
    toast('✅ Schedule added!');
  }

  function deleteTimetable(day) {
    delete timetable[day];
    localStorage.setItem('tt', JSON.stringify(timetable));
    renderTimetable();
    toast('🗑 Removed ' + day);
  }

  function renderTimetable() {
    const list = document.getElementById('tt-list');
    const empty = document.getElementById('tt-empty');
    const days = Object.keys(timetable);
    if (days.length === 0) { empty.style.display = ''; list.innerHTML = ''; return; }
    empty.style.display = 'none';
    const order = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
    days.sort((a,b) => order.indexOf(a) - order.indexOf(b));
    list.innerHTML = days.map(day => `
      <div class="tt-entry">
        <span class="tt-day">${day}</span>
        <span class="tt-subjects">${timetable[day]}</span>
        <button class="btn btn-danger" onclick="deleteTimetable('${day}')">✕</button>
      </div>
    `).join('');
  }

  // ── ASSIGNMENTS ──────────────────────────────────────────
  function addAssignment() {
    const name = document.getElementById('a-name').value.trim();
    const subject = document.getElementById('a-subject').value.trim();
    const deadline = document.getElementById('a-deadline').value;
    if (!name || !subject || !deadline) { toast('⚠ Fill all fields'); return; }
    assignments.push({ id: Date.now(), name, subject, deadline, done: false });
    localStorage.setItem('asgn', JSON.stringify(assignments));
    document.getElementById('a-name').value = '';
    document.getElementById('a-subject').value = '';
    document.getElementById('a-deadline').value = '';
    renderAssignments();
    toast('✅ Assignment added!');
  }

  function toggleDone(id) {
    const a = assignments.find(x => x.id === id);
    if (a) a.done = !a.done;
    localStorage.setItem('asgn', JSON.stringify(assignments));
    renderAssignments();
  }

  function deleteAssignment(id) {
    assignments = assignments.filter(x => x.id !== id);
    localStorage.setItem('asgn', JSON.stringify(assignments));
    renderAssignments();
    toast('🗑 Assignment removed');
  }

  function getChip(deadline, done) {
    if (done) return '<span class="chip on-time">Done ✓</span>';
    const today = new Date(); today.setHours(0,0,0,0);
    const due = new Date(deadline);
    const diff = Math.ceil((due - today) / 86400000);
    if (diff < 0) return '<span class="chip overdue">Overdue</span>';
    if (diff <= 3) return `<span class="chip due-soon">Due in ${diff}d</span>`;
    return `<span class="chip on-time">Due in ${diff}d</span>`;
  }

  function renderAssignments() {
    const list = document.getElementById('a-list');
    const empty = document.getElementById('a-empty');
    if (assignments.length === 0) { empty.style.display = ''; list.innerHTML = ''; updateStats(); return; }
    empty.style.display = 'none';
    const sorted = [...assignments].sort((a,b) => new Date(a.deadline) - new Date(b.deadline));
    list.innerHTML = sorted.map(a => `
      <div class="asgn-entry ${a.done ? 'done' : ''}">
        <div class="asgn-info">
          <div class="asgn-name">${a.name}</div>
          <div class="asgn-meta">
            <span class="chip">${a.subject}</span>
            ${getChip(a.deadline, a.done)}
            <span style="color:var(--muted);font-size:.7rem">${formatDate(a.deadline)}</span>
          </div>
        </div>
        <div class="asgn-actions">
          <button class="btn btn-done" onclick="toggleDone(${a.id})">${a.done ? 'Undo' : 'Done'}</button>
          <button class="btn btn-danger" onclick="deleteAssignment(${a.id})">✕</button>
        </div>
      </div>
    `).join('');
    updateStats();
  }

  function updateStats() {
    const total = assignments.length;
    const done = assignments.filter(a => a.done).length;
    document.getElementById('stat-total').textContent = total;
    document.getElementById('stat-pending').textContent = total - done;
    document.getElementById('stat-done').textContent = done;
  }

  function formatDate(d) {
    return new Date(d).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' });
  }

  // ── Init ─────────────────────────────────────────────────
  renderTimetable();
  renderAssignments();
</script>
</body>
</html>
